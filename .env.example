# Notion API Credentials
# 1. Create an integration at https://www.notion.so/my-integrations to get your token
NOTION_API_KEY=ntn_your_notion_integration_token_here
# 2. Open your Notion Job Board database, click 'Share' -> Add your integration connection
# 3. Copy the database ID from the database URL: https://www.notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=your_notion_database_id_here

# Firecrawl API Credentials (Used for job scraping and recruiter intelligence)
# Get your API key from https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here

# Resend API Credentials (Used for automated recruiter outreach delivery)
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_SENDER="Your Name <onboarding@resend.dev>"
REPLY_TO_EMAIL="your_email@domain.com"
